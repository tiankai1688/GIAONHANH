APP_NAME=GIAONHANH
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=giaonhanh
DB_USERNAME=root
DB_PASSWORD=

# Frontend / mobile origins allowed to call this API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8765,capacitor://localhost,https://your-cloud-preview-url

# Business policy (0 commission + delivery subsidy model)
PLATFORM_COMMISSION_RATE=0
DELIVERY_SUBSIDY_ENABLED=true
NEW_USER_COUPON_AMOUNT=20000

# Payment gateways (MoMo / ZaloPay) - fill with real credentials in production
# Leave blank to run the SANDBOX cashier (public/pay-mock.html) with REAL
# signature verification. Fill these to route live traffic to the PSPs.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/pay
# Public URLs MoMo/ZaloPay call back to (must be reachable from the PSP):
MOMO_IPN_URL=
MOMO_REDIRECT_URL=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sandbox.zalopay.com.vn/v001/tpe/createorder
ZALOPAY_REDIRECT_URL=

# Licensed AGGREGATOR mode (compliance: platform never pools customer funds).
# Set to a licensed aggregator id (e.g. sepay / payoo) to route wallet payments
# through it. Leave "none" to connect MoMo / ZaloPay directly (they are licensed
# PSPs; platform settles as the registered merchant and pays merchants out).
PAYMENT_AGGREGATOR=none
AGGREGATOR_API_KEY=
AGGREGATOR_ENDPOINT=
AGGREGATOR_MERCHANT_ACCOUNT=

# Sandbox cashier (used ONLY when explicitly enabled for local dev).
# DEFAULT IS OFF: a production deploy that forgets to set real PSP keys is now
# safe (verification fails closed on the real keys). Set to true + a secret in
# a LOCAL/dev .env to exercise the mock pay-mock.html cashier end-to-end.
PAYMENT_SANDBOX=false
PAYMENT_SANDBOX_SECRET=GIAONHANH_SANDBOX_SECRET

SANCTUM_STATEFUL_DOMAINS=localhost

# Real-time broadcasting (Pusher / Ably). "null" = events fire but aren't pushed.
BROADCAST_DRIVER=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
ABLY_KEY=

# Push notifications (FCM legacy server key). Empty = push is logged, never errors.
FCM_SERVER_KEY=
